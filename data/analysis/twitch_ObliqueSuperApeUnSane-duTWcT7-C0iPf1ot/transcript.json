{
  "language": "es",
  "segments": [
    {
      "start": 0.9,
      "end": 3.9,
      "text": "Bueno, Lucía se merece otro chocolate. Trabajo mucho hoy."
    },
    {
      "start": 5.9,
      "end": 6.9,
      "text": "¡Ay, no! ¿Por qué?"
    },
    {
      "start": 9.9,
      "end": 12.9,
      "text": "Si usted me voltee un metro segundo y hizo algo raro, ¿qué hizo?"
    },
    {
      "start": 12.9,
      "end": 14.9,
      "text": "Lo estrella contra la pared ahí está, tío."
    },
    {
      "start": 15.9,
      "end": 18.9,
      "text": "Se la meto al cajero de ahí, güey."
    },
    {
      "start": 19.9,
      "end": 21.9,
      "text": "Confundir gatillo con el botón de ala."
    },
    {
      "start": 22.9,
      "end": 25.9,
      "text": "¡Ségueme tan divertido! No te pases."
    },
    {
      "start": 25.9,
      "end": 27.9,
      "text": "¡Tú vienes chocolate! ¡Pura verga!"
    }
  ]
}