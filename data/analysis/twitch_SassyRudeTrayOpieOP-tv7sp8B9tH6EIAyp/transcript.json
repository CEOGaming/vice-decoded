{
  "language": "pt",
  "segments": [
    {
      "start": 0.0,
      "end": 5.1,
      "text": "É agora, por todo um povo, Luce! Por todo um povo! Por todo um povo!"
    },
    {
      "start": 5.1,
      "end": 7.4,
      "text": "Vai rolar! Vai rolar o Brasil!"
    },
    {
      "start": 7.4,
      "end": 11.7,
      "text": "Uuuuuh!"
    },
    {
      "start": 11.7,
      "end": 13.6,
      "text": "Estou falando! Ha-ha-ha!"
    },
    {
      "start": 13.6,
      "end": 18.0,
      "text": "Ah, paga você também! Ha-ha-ha!"
    },
    {
      "start": 18.0,
      "end": 23.8,
      "text": "É isso! É isso, pô! Vai lá, abri seu portão, vai!"
    },
    {
      "start": 23.8,
      "end": 25.3,
      "text": "Vai lá, abri seu portão!"
    },
    {
      "start": 25.3,
      "end": 29.1,
      "text": "Justa, eu não queria fazer mais um trabalho com o seu bico, amigos."
    },
    {
      "start": 29.1,
      "end": 31.1,
      "text": "Ah, é... Ah, é..."
    },
    {
      "start": 31.2,
      "end": 32.5,
      "text": "É não um problema!"
    },
    {
      "start": 32.5,
      "end": 35.7,
      "text": "Isso vai ser a última vez que eu posso sentir..."
    },
    {
      "start": 35.7,
      "end": 36.5,
      "text": "Justa..."
    },
    {
      "start": 36.5,
      "end": 37.6,
      "text": "Ah..."
    },
    {
      "start": 37.6,
      "end": 39.6,
      "text": "Eu vou justa pegar ele para o bico!"
    },
    {
      "start": 39.6,
      "end": 41.2,
      "text": "Ah, eu..."
    },
    {
      "start": 41.2,
      "end": 44.2,
      "text": "Se você está trabalhando com meus senhores batatas..."
    },
    {
      "start": 44.2,
      "end": 49.0,
      "text": "Eu vou suportar ele, então..."
    }
  ]
}