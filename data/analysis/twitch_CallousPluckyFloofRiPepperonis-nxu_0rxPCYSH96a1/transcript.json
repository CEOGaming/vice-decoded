    {
      "start": 0.0,
      "end": 2.9,
      "text": "Hast du mir nicht gesagt, dass sie dir in deinem Arm gebildet hat, dass du die letzte Zeit nicht herabgabst?"
    },
    {
      "start": 2.9,
      "end": 3.4,
      "text": "Ja."
    },
    {
      "start": 4.2,
      "end": 5.7,
      "text": "Mach doch ein gutes Zeit, Lopper!"
    },
    {
      "start": 5.7,
      "end": 6.7,
      "text": "Ich bin gut."
    },
    {
      "start": 9.4,
      "end": 11.4,
      "text": "Oh, ich hab das schon gemacht."
    },
    {
      "start": 14.4,
      "end": 16.4,
      "text": "Du bist genau so wie ich, so wie ich sie gesagt habe."
    },
    {
      "start": 16.4,
      "end": 17.4,
      "text": "Okay."
    },
    {
      "start": 17.4,
      "end": 19.4,
      "text": "Wenn ich sage, dass du nichts machst, dann mach ich nichts."
    },
    {
      "start": 19.4,
      "end": 21.4,
      "text": "Great! Ich liebe nichts."
    },
    {
