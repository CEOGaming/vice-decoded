{
  "language": "de",
  "segments": [
    {
      "start": 0.0,
      "end": 2.0,
      "text": "Mal gucken, Alter, wenn ich selbst Juts stieße, mach"
    },
    {
      "start": 2.0,
      "end": 3.2,
      "text": "Komm her, du Penner!"
    },
    {
      "start": 4.2,
      "end": 5.7,
      "text": "Kick in deine Fresse!"
    },
    {
      "start": 6.0,
      "end": 7.2,
      "text": "Box mich an, du"
    },
    {
      "start": 7.2,
      "end": 8.4,
      "text": "Badnesser!"
    },
    {
      "start": 11.5,
      "end": 12.3,
      "text": "Hör nicht auf!"
    },
    {
      "start": 13.6,
      "end": 14.4,
      "text": "Alter!"
    },
    {
      "start": 15.1,
      "end": 17.5,
      "text": "Jetzt wollen die Bullen mich, ich wollte mich nur retten hier!"
    },
    {
      "start": 17.7,
      "end": 19.0,
      "text": "Sollte die scheiße denn?"
    },
    {
      "start": 19.3,
      "end": 20.2,
      "text": "Du Penner!"
    },
    {
      "start": 22.3,
      "end": 23.8,
      "text": "Oh, Scheiße, werd' dich!"
    },
    {
      "start": 24.5,
      "end": 25.8,
      "text": "Wärme auch, Scheiße!"
    },
    {
      "start": 27.6,
      "end": 30.1,
      "text": "Oh Gott, da passt hier wieder mein Penner, du Scheiße baut!"
    }
  ]
}