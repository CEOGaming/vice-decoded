{
  "language": "ru",
  "segments": [
    {
      "start": 0.0,
      "end": 2.0,
      "text": "Тоже желеточка"
    },
    {
      "start": 2.0,
      "end": 10.5,
      "text": "Двухсторонняя"
    },
    {
      "start": 10.5,
      "end": 15.4,
      "text": "Блин"
    },
    {
      "start": 15.4,
      "end": 17.4,
      "text": "Замок дурацкий"
    },
    {
      "start": 17.4,
      "end": 19.4,
      "text": "Так, есть"
    },
    {
      "start": 19.4,
      "end": 22.4,
      "text": "Ну типа чёрная, но может быть и не чёрная"
    },
    {
      "start": 22.4,
      "end": 26.8,
      "text": "Да это не для Эми, это уже для меня"
    },
    {
      "start": 26.8,
      "end": 28.8,
      "text": "Пока"
    },
    {
      "start": 28.8,
      "end": 32.4,
      "text": "Оп, и пошла"
    },
    {
      "start": 32.4,
      "end": 34.4,
      "text": "Эс-желетка"
    },
    {
      "start": 34.4,
      "end": 38.7,
      "text": "И всё, и пошла"
    },
    {
      "start": 38.7,
      "end": 42.9,
      "text": "По своим делам гулять"
    },
    {
      "start": 42.9,
      "end": 44.9,
      "text": "Да, замок, конечно, полный кал"
    },
    {
      "start": 44.9,
      "end": 46.9,
      "text": "Не закрывается"
    },
    {
      "start": 46.9,
      "end": 51.2,
      "text": "Вот, есть"
    },
    {
      "start": 51.2,
      "end": 55.4,
      "text": "О, такая вот жлеточка"
    },
    {
      "start": 55.4,
      "end": 57.4,
      "text": "И пошла"
    },
    {
      "start": 57.4,
      "end": 58.4,
      "text": "Норм?"
    },
    {
      "start": 58.4,
      "end": 60.4,
      "text": "Ой, Юль, ты тут?"
    }
  ]
}