{
  "language": "es",
  "segments": [
    {
      "start": 0.4,
      "end": 1.9,
      "text": "Espera, ¿dónde está el estatuto?"
    },
    {
      "start": 1.9,
      "end": 3.2,
      "text": "¡Pati, te ayuda a ver!"
    },
    {
      "start": 3.2,
      "end": 4.7,
      "text": "¿No está en mi?"
    },
    {
      "start": 4.7,
      "end": 6.2,
      "text": "¿Qué es en el barco?"
    },
    {
      "start": 6.2,
      "end": 7.4,
      "text": "¿En este barco?"
    },
    {
      "start": 7.4,
      "end": 8.6,
      "text": "¡Susurra que está en el barco!"
    },
    {
      "start": 8.6,
      "end": 10.9,
      "text": "¿En este barco? ¿No hay bronzo?"
    },
    {
      "start": 10.9,
      "end": 13.9,
      "text": "¡Susurra que está en mi barco!"
    },
    {
      "start": 13.9,
      "end": 14.9,
      "text": "¡Mi amor!"
    },
    {
      "start": 14.9,
      "end": 20.5,
      "text": "¡Es suma!"
    },
    {
      "start": 20.5,
      "end": 21.7,
      "text": "¡Susurra que está en mi barco!"
    },
    {
      "start": 21.7,
      "end": 28.4,
      "text": "¿Hemos dicho eso?"
    },
    {
      "start": 28.4,
      "end": 29.9,
      "text": "Sí, ¡susurra!"
    }
  ]
}