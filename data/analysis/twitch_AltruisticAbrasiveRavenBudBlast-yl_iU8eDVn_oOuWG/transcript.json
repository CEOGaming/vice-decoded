{
  "language": "pl",
  "segments": [
    {
      "start": 2.5,
      "end": 6.6,
      "text": "To zobaczymy."
    },
    {
      "start": 6.6,
      "end": 7.6,
      "text": "Okej?"
    },
    {
      "start": 7.6,
      "end": 13.1,
      "text": "Okej?"
    },
    {
      "start": 18.1,
      "end": 21.1,
      "text": "Jesteś jak krewetka prosto z piekarnika ciepła i pachnąca."
    },
    {
      "start": 23.1,
      "end": 26.1,
      "text": "Chodź, twój brat pragnie spróbować pierwszego kęsa."
    },
    {
      "start": 28.1,
      "end": 29.1,
      "text": "Koseluj się, starczy."
    },
    {
      "start": 30.1,
      "end": 32.1,
      "text": "Twoja siła mnie pochłania."
    },
    {
      "start": 32.1,
      "end": 35.1,
      "text": "Twa namiętność wciąga jak wzburzona rzeka i..."
    },
    {
      "start": 35.1,
      "end": 39.1,
      "text": "Nie wiem, czy się opanuje."
    },
    {
      "start": 39.1,
      "end": 45.7,
      "text": "To jest dobre z tym. To pasuje do takiego lektura."
    },
    {
      "start": 45.7,
      "end": 47.7,
      "text": "Och, co za rozkosz, Marisol."
    },
    {
      "start": 47.7,
      "end": 50.7,
      "text": "Twoje wargi są jak galaretka truskawkowa."
    },
    {
      "start": 51.7,
      "end": 53.7,
      "text": "Drżą i wabią mnie."
    }
  ]
}