{
  "language": "zh",
  "segments": [
    {
      "start": 0.0,
      "end": 2.9,
      "text": "GTA5後面其實有一些獨場搶劫什麼之類"
    },
    {
      "start": 2.9,
      "end": 4.3,
      "text": "我就是還是可以一直重複玩"
    },
    {
      "start": 4.3,
      "end": 5.6,
      "text": "就刷副本啦"
    },
    {
      "start": 5.6,
      "end": 7.7,
      "text": "對 有點像刷副本 這樣一直重複打"
    },
    {
      "start": 7.7,
      "end": 9.3,
      "text": "主要是賺錢嗎"
    },
    {
      "start": 9.3,
      "end": 11.0,
      "text": "還是沒有就是享受那個過程"
    },
    {
      "start": 11.0,
      "end": 13.0,
      "text": "賺錢 然後跟享受過程"
    },
    {
      "start": 13.0,
      "end": 15.3,
      "text": "因為其實基本上我在裡面是財富自由"
    },
    {
      "start": 15.3,
      "end": 16.9,
      "text": "在裡面"
    },
    {
      "start": 16.9,
      "end": 18.0,
      "text": "那你有課金過嗎"
    },
    {
      "start": 18.0,
      "end": 19.2,
      "text": "沒有耶 沒有"
    },
    {
      "start": 19.2,
      "end": 21.7,
      "text": "我跟妳講我是老匠人 手搓是嗎"
    },
    {
      "start": 21.7,
      "end": 24.9,
      "text": "老匠人 老匠人已經課金手搓"
    },
    {
      "start": 24.9,
      "end": 26.6,
      "text": "我不課金老匠人"
    },
    {
      "start": 26.6,
      "end": 27.7,
      "text": "我是老刷人耶"
    },
    {
      "start": 27.7,
      "end": 29.1,
      "text": "哇 五年沒上"
    },
    {
      "start": 29.1,
      "end": 30.1,
      "text": "我想弄都可以買喔"
    },
    {
      "start": 30.1,
      "end": 31.8,
      "text": "那我先可以擔任殺羽頭"
    },
    {
      "start": 31.8,
      "end": 33.8,
      "text": "我就是老匠人"
    },
    {
      "start": 33.8,
      "end": 34.5,
      "text": "很多人也沒上"
    },
    {
      "start": 34.5,
      "end": 36.0,
      "text": "哇 是這麼多可以課喔"
    },
    {
      "start": 36.0,
      "end": 36.9,
      "text": "我就滾掉了"
    },
    {
      "start": 36.9,
      "end": 37.7,
      "text": "這麼多可以課喔"
    },
    {
      "start": 37.7,
      "end": 39.9,
      "text": "但我還是開我那個最以前的那個車子"
    }
  ]
}