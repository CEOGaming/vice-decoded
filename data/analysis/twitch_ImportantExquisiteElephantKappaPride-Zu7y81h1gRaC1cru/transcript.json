  "segments": [
    {
      "start": 1.1,
      "end": 1.6,
      "text": "這是什麼"
    },
    {
      "start": 1.6,
      "end": 2.5,
      "text": "這是什麼東西"
    },
    {
      "start": 2.5,
      "end": 3.9,
      "text": "榴彈發射器"
    },
    {
      "start": 4.5,
      "end": 5.7,
      "text": "哇嗆咧"
    },
    {
      "start": 6.0,
      "end": 10.1,
      "text": "吼吼吼吼吼吼吼"
    },
    {
      "start": 11.4,
      "end": 12.1,
      "text": "嘎啊"
    },
    {
      "start": 23.4,
      "end": 24.1,
      "text": "你媽"
    },
    {
      "start": 24.1,
      "end": 24.5,
      "text": "獨當"
    },
    {
      "start": 35.9,
      "end": 38.6,
      "text": "你他媽的我才看看是爽欸"
    },
    {
      "start": 38.6,
      "end": 39.3,
      "text": "他媽怎麼"
    },
    {
      "start": 39.7,
      "end": 41.0,
      "text": "怎麼一炸就死了啦"
    },
    {
      "start": 41.0,
      "end": 42.1,
      "text": "有太近的啦"
    },
    {
      "start": 42.1,
      "end": 42.8,
      "text": "有他媽"
    },
    {
      "start": 46.7,
      "end": 47.2,
      "text": "啊讀錯了"
    },
    {
      "start": 47.2,
      "end": 48.1,
      "text": "哦讀錯了讀錯了"
    },
    {
      "start": 48.1,
      "end": 48.5,
      "text": "可不可以"
    },
    {
      "start": 52.8,
      "end": 53.6,
      "text": "按錯了按錯了按錯了"
    },
    {
      "start": 53.6,
      "end": 54.0,
      "text": "太快了"
    },
    {
      "start": 54.0,
      "end": 54.7,
      "text": "按按按開了"
    },
    {
      "start": 54.7,
      "end": 56.4,
      "text": "再讀一次再讀一次"
    },
    {
      "start": 57.3,
      "end": 58.4,
      "text": "好妹好妹"
    }
