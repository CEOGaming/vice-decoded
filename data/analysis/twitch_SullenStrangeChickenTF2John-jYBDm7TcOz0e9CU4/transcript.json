{
  "language": "de",
  "segments": [
    {
      "start": 0.7,
      "end": 2.7,
      "text": "Heli über mir, dem müssen wir mal wegmachen."
    },
    {
      "start": 3.7,
      "end": 8.9,
      "text": "Ich komme oben an den Heli nicht ran."
    },
    {
      "start": 8.9,
      "end": 10.9,
      "text": "Oh, oh mein Gott!"
    },
    {
      "start": 10.9,
      "end": 14.8,
      "text": "Also..."
    },
    {
      "start": 14.8,
      "end": 16.8,
      "text": "Ich sag euch ehrlich,"
    },
    {
      "start": 16.8,
      "end": 18.8,
      "text": "das Ding macht Spaß."
    },
    {
      "start": 18.8,
      "end": 21.8,
      "text": "Das kann auch verhältnismäßig recht viel ab."
    },
    {
      "start": 21.8,
      "end": 22.8,
      "text": "Finde ich."
    },
    {
      "start": 22.8,
      "end": 26.9,
      "text": "Hohohohoho!"
    },
    {
      "start": 26.9,
      "end": 29.9,
      "text": "Was ne Amokfahrt, Digger, leck mich am Arsch!"
    },
    {
      "start": 30.9,
      "end": 32.9,
      "text": "Was ne Amokfahrt?"
    },
    {
      "start": 32.9,
      "end": 36.9,
      "text": "Bis auf den Platten ist auch noch nichts mit dem Ding, oder?"
    },
    {
      "start": 36.9,
      "end": 41.5,
      "text": "Bis auf den Platten ist alles noch gut."
    },
    {
      "start": 41.5,
      "end": 43.5,
      "text": "Funktioniert alles noch einwandfrei."
    },
    {
      "start": 43.5,
      "end": 45.5,
      "text": "Ey, was ist los?"
    },
    {
      "start": 45.5,
      "end": 46.5,
      "text": "Tschüss."
    },
    {
      "start": 46.5,
      "end": 54.3,
      "text": "Oh ja, Digger Baby, genau das!"
    },
    {
      "start": 54.3,
      "end": 58.2,
      "text": "Genau das!"
    },
    {
      "start": 58.2,
      "end": 60.2,
      "text": "Oh mein Gott, der Digger!"
    }
  ]
}