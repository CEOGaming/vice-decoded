{
  "language": "ru",
  "segments": [
    {
      "start": 0.0,
      "end": 3.6,
      "text": "Где может заехать на велосипеде в магаз и взять пивка?"
    },
    {
      "start": 3.6,
      "end": 5.6,
      "text": "Ну типа, кому он? Нихрена себе."
    },
    {
      "start": 8.1,
      "end": 11.1,
      "text": "И разговаривать по телефону, как будто вообще здесь всё окей."
    },
    {
      "start": 11.1,
      "end": 14.1,
      "text": "И вот ещё вот так вот ножку отодвинуть, чтобы были трусики видны."
    },
    {
      "start": 14.1,
      "end": 15.6,
      "text": "Ну, ну."
    },
    {
      "start": 15.6,
      "end": 17.6,
      "text": "Уберите сабы отсюда, ёма."
    },
    {
      "start": 25.1,
      "end": 28.1,
      "text": "Окей, ладно, я по телефону дальше разговариваю."
    },
    {
      "start": 28.1,
      "end": 30.1,
      "text": "Ты чего?"
    },
    {
      "start": 30.1,
      "end": 32.1,
      "text": "Ты чего дерёшься?"
    },
    {
      "start": 32.1,
      "end": 33.1,
      "text": "Вот это..."
    },
    {
      "start": 33.1,
      "end": 35.1,
      "text": "Феминистки подъехали."
    },
    {
      "start": 35.1,
      "end": 37.1,
      "text": "Видишь, она завидит мне, что у меня красивая женщина."
    },
    {
      "start": 37.1,
      "end": 39.1,
      "text": "Видишь, что творится?"
    },
    {
      "start": 39.1,
      "end": 41.1,
      "text": "Что, что?"
    },
    {
      "start": 41.1,
      "end": 43.1,
      "text": "Мы заводчики хотели тебе касту сделать."
    },
    {
      "start": 43.1,
      "end": 45.1,
      "text": "Подумай об этом."
    },
    {
      "start": 45.1,
      "end": 48.1,
      "text": "Ну, смотри, шоколадок возьмём у тебя."
    },
    {
      "start": 48.1,
      "end": 50.1,
      "text": "А ты тут злишься стоишь."
    },
    {
      "start": 50.1,
      "end": 52.1,
      "text": "Да, я, по-моему, там споткос об велосипед."
    },
    {
      "start": 52.1,
      "end": 57.8,
      "text": "Всё."
    },
    {
      "start": 57.8,
      "end": 59.8,
      "text": "Как ограбить магазин?"
    }
  ]
}