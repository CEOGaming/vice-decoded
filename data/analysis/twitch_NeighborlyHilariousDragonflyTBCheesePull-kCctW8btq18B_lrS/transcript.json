{
  "language": "de",
  "segments": [
    {
      "start": 0.0,
      "end": 5.4,
      "text": "Soll ich wirklich?"
    },
    {
      "start": 9.0,
      "end": 13.4,
      "text": "Du musst viel schneller gehen. Es geht ja nicht schnell. Du musst dann auf die Sorge sorten. Was labert ihr?"
    },
    {
      "start": 15.2,
      "end": 17.2,
      "text": "Auf deine Mutter und dein Vater."
    },
    {
      "start": 18.0,
      "end": 22.0,
      "text": "Digga, wie, also wie kann man so dermaßen abpacken?"
    },
    {
      "start": 22.9,
      "end": 24.9,
      "text": "Oh mein Gott, das ist eine Wand."
    },
    {
      "start": 25.5,
      "end": 27.5,
      "text": "Das ist einfach eine Wand. Ich dachte, das..."
    },
    {
      "start": 30.9,
      "end": 34.9,
      "text": "Oh mein Gott. Okay, sieben und zehn, fünfzig."
    },
    {
      "start": 35.5,
      "end": 37.5,
      "text": "Nee, das ist automatisch."
    },
    {
      "start": 37.5,
      "end": 40.8,
      "text": "Ach, Mann."
    },
    {
      "start": 41.4,
      "end": 43.4,
      "text": "Das sah voll echt aus, ne?"
    },
    {
      "start": 43.4,
      "end": 45.4,
      "text": "Aber ich höre, dass es echt ist."
    },
    {
      "start": 45.4,
      "end": 49.1,
      "text": "Aber das ist das zweite..."
    }
  ]
}