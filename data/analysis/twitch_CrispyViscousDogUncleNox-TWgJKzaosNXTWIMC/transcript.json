{
  "language": "pt",
  "segments": [
    {
      "start": 0.0,
      "end": 2.6,
      "text": "Eu vou marcar as áreas para ver como ele vai."
    },
    {
      "start": 2.6,
      "end": 5.7,
      "text": "Eles são, tipo, duas vezes as olhos de todos os outros aqui."
    },
    {
      "start": 5.7,
      "end": 7.2,
      "text": "Deve ter um lugar bem rápido."
    },
    {
      "start": 7.2,
      "end": 9.2,
      "text": "Sim, isso não é eles."
    },
    {
      "start": 17.2,
      "end": 19.2,
      "text": "Parece que eles são eles para mim."
    },
    {
      "start": 19.2,
      "end": 23.7,
      "text": "É um barulho de água?"
    },
    {
      "start": 23.7,
      "end": 25.7,
      "text": "Sim, esqueci de dizer que era um novo lugar."
    },
    {
      "start": 28.7,
      "end": 30.7,
      "text": "É tão jovem."
    }
  ]
}