{
  "language": "pt",
  "segments": [
    {
      "start": 0.0,
      "end": 2.6,
      "text": "Eu vou marcar as áreas para ver como ele vai."
    },
    {
      "start": 2.6,
      "end": 5.7,
      "text": "Eles são tipo, duas vezes as olhos de todos os outros aqui."
    },
    {
      "start": 5.7,
      "end": 7.1,
      "text": "Deve ter um lugar bem rápido."
    },
    {
      "start": 7.1,
      "end": 9.6,
      "text": "Sim, isso não é eles."
    },
    {
      "start": 17.3,
      "end": 19.3,
      "text": "Parece que eles são como eu."
    },
    {
      "start": 19.3,
      "end": 23.8,
      "text": "É um barulho de água."
    },
    {
      "start": 23.8,
      "end": 25.8,
      "text": "Ah sim, esqueci de dizer que era um novo lugar."
    },
    {
      "start": 28.8,
      "end": 29.8,
      "text": "É tão jovem."
    }
  ]
}