{
  "language": "de",
  "segments": [
    {
      "start": 1.3,
      "end": 3.3,
      "text": "Deswegen dachte ich, es wird so viel mehr sein."
    },
    {
      "start": 5.3,
      "end": 7.3,
      "text": "Eine einzigen gute Kampf."
    },
    {
      "start": 16.2,
      "end": 20.7,
      "text": "Oh mein Gott, fast in mein Auto."
    },
    {
      "start": 20.7,
      "end": 22.7,
      "text": "Wie so ein Panzerwahl."
    },
    {
      "start": 24.7,
      "end": 26.7,
      "text": "Oh, ich bin so erschrocken, man."
    },
    {
      "start": 26.7,
      "end": 28.7,
      "text": "Dieser Basta."
    },
    {
      "start": 28.7,
      "end": 31.7,
      "text": "Warum müssen die jedes Mal so übertreiben, wenn man die ein bisschen anrahmt?"
    }
  ]
}