{
  "language": "ru",
  "segments": [
    {
      "start": 0.0,
      "end": 5.0,
      "text": "Никаких больше свар, никаких албанцев. Gigi снова в деле."
    },
    {
      "start": 5.0,
      "end": 8.0,
      "text": "Ну тогда Gigi будет, значит."
    },
    {
      "start": 8.0,
      "end": 11.0,
      "text": "Слышите, папочка вернулся, суки."
    },
    {
      "start": 11.0,
      "end": 13.0,
      "text": "Ты что, ноги убери."
    },
    {
      "start": 13.0,
      "end": 16.2,
      "text": "Ай-ай-ай-ай-ай."
    },
    {
      "start": 16.2,
      "end": 19.2,
      "text": "Это кто у нас здесь?"
    },
    {
      "start": 19.2,
      "end": 22.2,
      "text": "Какие люди."
    },
    {
      "start": 22.2,
      "end": 25.2,
      "text": "Давно не виделись."
    },
    {
      "start": 25.2,
      "end": 28.2,
      "text": "Жоржа, прикрой яйца."
    },
    {
      "start": 28.2,
      "end": 30.2,
      "text": "Никобелик, брат мой!"
    },
    {
      "start": 30.2,
      "end": 34.8,
      "text": "Да чего в мешочке?"
    },
    {
      "start": 34.8,
      "end": 36.8,
      "text": "Рад тебя видеть."
    },
    {
      "start": 36.8,
      "end": 39.8,
      "text": "Не ожидал, что ты проделаешь такой путь. Что случилось?"
    },
    {
      "start": 39.8,
      "end": 43.8,
      "text": "Сюда я мог приехать лишь по одной причине."
    },
    {
      "start": 43.8,
      "end": 46.8,
      "text": "Ты конкретно облажался."
    },
    {
      "start": 46.8,
      "end": 48.8,
      "text": "Ты за поставки?"
    },
    {
      "start": 48.8,
      "end": 51.8,
      "text": "Брат, по этому поводу можешь не переживать."
    },
    {
      "start": 51.8,
      "end": 53.8,
      "text": "Мы все вернем."
    },
    {
      "start": 53.8,
      "end": 55.8,
      "text": "Два миллиарда долларов."
    },
    {
      "start": 55.8,
      "end": 57.8,
      "text": "Вот так просто все вернешь?"
    },
    {
      "start": 57.8,
      "end": 59.8,
      "text": "Серьезно?"
    }
  ]
}