{
  "language": "en",
  "segments": [
    {
      "start": 0.5,
      "end": 3.5,
      "text": "All right, I think I'm done here."
    },
    {
      "start": 3.5,
      "end": 5.5,
      "text": "You should work fine now."
    },
    {
      "start": 5.5,
      "end": 8.5,
      "text": "These are my dads, but I think you forgot about them."
    },
    {
      "start": 8.5,
      "end": 10.5,
      "text": "You can have them for fixing my sink."
    },
    {
      "start": 10.5,
      "end": 13.5,
      "text": "Oh, I appreciate that, Mandy."
    },
    {
      "start": 13.5,
      "end": 15.5,
      "text": "What's up, Jason?"
    },
    {
      "start": 15.5,
      "end": 17.5,
      "text": "Why don't you like me?"
    },
    {
      "start": 17.5,
      "end": 18.5,
      "text": "What?"
    },
    {
      "start": 18.5,
      "end": 19.5,
      "text": "Who are you with?"
    },
    {
      "start": 19.5,
      "end": 21.5,
      "text": "Nobody."
    },
    {
      "start": 21.5,
      "end": 23.5,
      "text": "You're lying."
    },
    {
      "start": 23.5,
      "end": 24.5,
      "text": "No, I'm not."
    },
    {
      "start": 24.5,
      "end": 26.5,
      "text": "Yes, you are."
    },
    {
      "start": 26.5,
      "end": 28.5,
      "text": "I talked to the bartender at the Rusty Anchor,"
    },
    {
      "start": 28.5,
      "end": 32.5,
      "text": "and she told me that you have an ex-girlfriend in prison."
    },
    {
      "start": 32.5,
      "end": 35.5,
      "text": "You're getting back together with her, aren't you?"
    },
    {
      "start": 35.5,
      "end": 37.5,
      "text": "It's complicated."
    },
    {
      "start": 37.5,
      "end": 39.5,
      "text": "Just tell me the truth."
    },
    {
      "start": 39.5,
      "end": 41.5,
      "text": "You need to calm down. You're starting to freak me out."
    },
    {
      "start": 41.5,
      "end": 43.5,
      "text": "No, I have to know."
    },
    {
      "start": 43.5,
      "end": 45.5,
      "text": "I mean, what does a convict have that I don't have?"
    },
    {
      "start": 45.5,
      "end": 47.5,
      "text": "I'm gonna go back to work, all right?"
    },
    {
      "start": 47.5,
      "end": 49.5,
      "text": "No, Jason, you have to tell me."
    },
    {
      "start": 49.5,
      "end": 51.5,
      "text": "You and me, we were supposed to get married."
    },
    {
      "start": 51.5,
      "end": 53.5,
      "text": "We really fucking know each other."
    },
    {
      "start": 53.5,
      "end": 54.5,
      "text": "What was that?"
    },
    {
      "start": 54.5,
      "end": 56.5,
      "text": "Just leave me alone, Jason."
    },
    {
      "start": 56.5,
      "end": 58.5,
      "text": "You're pulling over!"
    },
    {
      "start": 58.5,
      "end": 60.5,
      "text": "Goddamn ballsack!"
    }
  ]
}