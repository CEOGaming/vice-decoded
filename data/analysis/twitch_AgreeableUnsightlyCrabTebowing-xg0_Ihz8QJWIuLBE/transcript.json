    {
      "start": 2.6,
      "end": 14.8,
      "text": "¡Nos fuimos!"
    },
    {
      "start": 14.8,
      "end": 16.9,
      "text": "¡El mar es infinito!"
    },
    {
      "start": 17.9,
      "end": 19.9,
      "text": "No, era algo así, no, pero bueno."
    },
    {
      "start": 19.9,
      "end": 21.9,
      "text": "Bueno, gente."
    },
    {
      "start": 23.9,
      "end": 25.9,
      "text": "No, hay que llamar a Halifax."
    },
    {
      "start": 47.0,
      "end": 52.3,
      "text": "Vale, gente. Voy a guardar la partida."
    },
    {
      "start": 52.3,
      "end": 54.3,
      "text": "Que me tengo que ir ya, que tengo que preparar cosas."
    },
    {
      "start": 54.3,
      "end": 57.3,
      "text": "Mañana nos vemos, pero mañana nos veremos más tarde noche."
    },
    {
      "start": 57.3,
      "end": 59.3,
      "text": "Tarde noche porque..."
    }
  ]
