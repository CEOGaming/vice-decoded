{
  "language": "es",
  "segments": [
    {
      "start": 0.0,
      "end": 1.4,
      "text": "que sigo con mis cosas, ¿no?"
    },
    {
      "start": 1.5,
      "end": 5.2,
      "text": "Entonces, pues eso, que es mucha gracia."
    },
    {
      "start": 5.6,
      "end": 7.4,
      "text": "¿De qué posición estamos hablando?"
    },
    {
      "start": 7.5,
      "end": 8.9,
      "text": "¿Cómo? Perdona."
    },
    {
      "start": 10.0,
      "end": 11.5,
      "text": "No sé a qué te residen."
    },
    {
      "start": 11.6,
      "end": 14.3,
      "text": "Sí, sí, me estáis pasando. Esto es locura, tío."
    },
    {
      "start": 14.8,
      "end": 16.1,
      "text": "Esto es una locura, ¿eh?"
    },
    {
      "start": 16.2,
      "end": 18.8,
      "text": "Con muchísimo respeto a toda la gente que hay aquí,"
    },
    {
      "start": 18.8,
      "end": 20.8,
      "text": "mis compañeros y tal. Nunca la enseño."
    },
    {
      "start": 20.9,
      "end": 23.4,
      "text": "Esto será la tercera vez en 10 años que enseño esto,"
    },
    {
      "start": 23.5,
      "end": 25.5,
      "text": "pero esto es una locura, tío."
    },
    {
      "start": 25.6,
      "end": 27.6,
      "text": "Es una barbaridad hispano- hablante"
    },
    {
      "start": 27.6,
      "end": 29.6,
      "text": "para el primero y en el mundo."
    }
  ]
}