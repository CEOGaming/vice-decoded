{
  "language": "ja",
  "segments": [
    {
      "start": 0.9,
      "end": 2.9,
      "text": "オレ、俺はここに行きました"
    },
    {
      "start": 2.9,
      "end": 5.2,
      "text": "よいしょ、お仕事をしてくれ"
    },
    {
      "start": 5.2,
      "end": 8.3,
      "text": "お仕事をしてくれ、でも、俺はそこに忘れていた"
    },
    {
      "start": 8.3,
      "end": 10.5,
      "text": "お仕事をしてくれ、そのお仕事をしてくれ"
    },
    {
      "start": 10.5,
      "end": 12.5,
      "text": "おぉ、おめでとう"
    },
    {
      "start": 14.0,
      "end": 15.5,
      "text": "ジェイセンはどうだったの?"
    },
    {
      "start": 15.5,
      "end": 16.8,
      "text": "なんでお気に入りしたの?"
    },
    {
      "start": 16.8,
      "end": 17.7,
      "text": "何?"
    },
    {
      "start": 17.7,
      "end": 19.5,
      "text": "誰でお仕事をしてるの?"
    },
    {
      "start": 19.7,
      "end": 21.0,
      "text": "誰だったの?"
    },
    {
      "start": 21.0,
      "end": 22.3,
      "text": "お仕事だったの?"
    },
    {
      "start": 23.5,
      "end": 24.6,
      "text": "いや、俺はな"
    },
    {
      "start": 24.6,
      "end": 25.4,
      "text": "はい"
    },
    {
      "start": 25.4,
      "end": 26.9,
      "text": "俺は仕事をしてくれ、オレ"
    },
    {
      "start": 26.9,
      "end": 28.6,
      "text": "オレ、ジェイス、お仕事をしてくれ"
    },
    {
      "start": 28.6,
      "end": 30.3,
      "text": "お仕事をしてくれ、俺はそこにCHEERING!"
    },
    {
      "start": 30.3,
      "end": 32.3,
      "text": "あったんだ へー"
    },
    {
      "start": 32.3,
      "end": 34.3,
      "text": "付き合ってもない あれ?"
    },
    {
      "start": 36.3,
      "end": 38.3,
      "text": "殺す"
    },
    {
      "start": 40.3,
      "end": 42.3,
      "text": "コーヒー飲んで 体力回復しとこう"
    },
    {
      "start": 54.4,
      "end": 60.6,
      "text": "来たー"
    }
  ]
