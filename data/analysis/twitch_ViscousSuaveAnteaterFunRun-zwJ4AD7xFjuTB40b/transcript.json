{
  "language": "nl",
  "segments": [
    {
      "start": 0.0,
      "end": 2.0,
      "text": "Dat is de slagte."
    },
    {
      "start": 2.0,
      "end": 4.0,
      "text": "Arturoon?"
    },
    {
      "start": 4.0,
      "end": 7.0,
      "text": "Ik heb geen kou die heeft arturoon."
    },
    {
      "start": 7.0,
      "end": 12.0,
      "text": "Ik draai het vaak op autopilen."
    },
    {
      "start": 12.0,
      "end": 16.0,
      "text": "Ik weet niet hoe dat moet uberhoudt op autopilendrijden."
    },
    {
      "start": 16.0,
      "end": 20.0,
      "text": "Oké, laten we even helemaal naar deze gaan."
    },
    {
      "start": 20.0,
      "end": 22.0,
      "text": "Die staat al zo lang open."
    },
    {
      "start": 22.0,
      "end": 24.0,
      "text": "Ik wil me een taxi doen trouwens."
    },
    {
      "start": 24.0,
      "end": 27.0,
      "text": "Die staat al een partij lang open."
    },
    {
      "start": 28.0,
      "end": 29.0,
      "text": "Art-slaans."
    },
    {
      "start": 29.0,
      "end": 31.0,
      "text": "Heb je daar geslaapen?"
    },
    {
      "start": 33.0,
      "end": 36.0,
      "text": "Wees niet bang, je bent niet de eerste die je slaap klett in de kal."
    },
    {
      "start": 36.0,
      "end": 38.0,
      "text": "Dat gebeurt best vaak."
    },
    {
      "start": 38.0,
      "end": 40.0,
      "text": "En dan moeten wij die genen disconnecten."
    },
    {
      "start": 40.0,
      "end": 42.0,
      "text": "Dat is echt heel fun."
    },
    {
      "start": 43.0,
      "end": 46.6,
      "text": "Dat gebeurt best vaak."
    },
    {
      "start": 47.6,
      "end": 49.6,
      "text": "Eigenlijk vaker dan verwacht."
    },
    {
      "start": 52.9,
      "end": 54.9,
      "text": "In slaapval en kals niet de eerste."
    },
    {
      "start": 54.9,
      "end": 57.9,
      "text": "Dat is ook zeker niet de laatste."
    }
  ]
}