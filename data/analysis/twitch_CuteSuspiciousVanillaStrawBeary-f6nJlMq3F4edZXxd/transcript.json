{
  "language": "it",
  "segments": [
    {
      "start": 0.0,
      "end": 2.0,
      "text": "un leggendario, una maglietta"
    },
    {
      "start": 2.0,
      "end": 4.0,
      "text": "ma come fai a salvare quel fuci"
    },
    {
      "start": 4.0,
      "end": 6.0,
      "text": "i quali leggendari te li servono automatico"
    },
    {
      "start": 6.0,
      "end": 8.0,
      "text": "ma non li perdi mai"
    },
    {
      "start": 8.0,
      "end": 10.0,
      "text": "mi ha tagliato la testa"
    },
    {
      "start": 12.0,
      "end": 14.0,
      "text": "che le ha?"
    },
    {
      "start": 14.0,
      "end": 16.0,
      "text": "un parco di mafa mi chiudo la finestra"
    },
    {
      "start": 16.0,
      "end": 18.0,
      "text": "ma senti che freddo fra"
    }
  ]
}