{
  "language": "pt",
  "segments": [
    {
      "start": 0.0,
      "end": 4.0,
      "text": "Eu queria ir ali, mas a gente precisa de um navio pra ir ali, eu não trouxe navio, eu só vim de avião"
    },
    {
      "start": 5.0,
      "end": 5.5,
      "text": "Ai"
    },
    {
      "start": 8.9,
      "end": 10.9,
      "text": "Cara, subi tudo pra nada mano, parabéns aí"
    },
    {
      "start": 18.3,
      "end": 20.8,
      "text": "Mano, ela caiu! Ela caiu lá embaixo!"
    },
    {
      "start": 21.8,
      "end": 22.8,
      "text": "Ai meu Deus, eu..."
    },
    {
      "start": 23.8,
      "end": 29.6,
      "text": "Caiu!"
    },
    {
      "start": 30.6,
      "end": 32.6,
      "text": "Tá bem que não era eu, mano"
    },
    {
      "start": 33.6,
      "end": 34.6,
      "text": "Se eu não tinha morrido"
    },
    {
      "start": 38.2,
      "end": 40.2,
      "text": "Bebê, você caiu, você tá bem... Meu Deus!"
    },
    {
      "start": 41.2,
      "end": 42.2,
      "text": "Meu Deus!"
    },
    {
      "start": 42.2,
      "end": 46.2,
      "text": "Bebê, pelo amor de Deus, você tomou um rolo lá de cima, que perigo!"
    },
    {
      "start": 47.2,
      "end": 48.2,
      "text": "Que perigo!"
    },
    {
      "start": 49.2,
      "end": 51.2,
      "text": "Tem que tomar cuidado!"
    },
    {
      "start": 57.0,
      "end": 59.0,
      "text": "Mano, namorar tomou um rolo lá de cima cara"
    }
  ]
