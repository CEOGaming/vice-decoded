{
  "language": "es",
  "segments": [
    {
      "start": 4.7,
      "end": 6.7,
      "text": "No sea pendejo que sea pendejo"
    },
    {
      "start": 6.7,
      "end": 14.6,
      "text": "Es que pendejo pero..."
    },
    {
      "start": 14.6,
      "end": 16.6,
      "text": "Baja, baja, con cuidado, con cuidado"
    },
    {
      "start": 17.6,
      "end": 18.6,
      "text": "Al agua, al agua"
    },
    {
      "start": 18.6,
      "end": 19.6,
      "text": "¡Párate, conchetos! ¡Pare!"
    },
    {
      "start": 19.6,
      "end": 21.6,
      "text": "¡Y a uno, a uno, a uno! ¡Mete el agua!"
    },
    {
      "start": 21.6,
      "end": 23.6,
      "text": "¡Va a volver a ser esta guabanicana!"
    },
    {
      "start": 23.6,
      "end": 24.6,
      "text": "¡Al agua, pato!"
    }
  ]
}