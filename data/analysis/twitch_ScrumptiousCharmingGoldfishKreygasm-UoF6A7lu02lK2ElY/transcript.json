{
  "language": "de",
  "segments": [
    {
      "start": 0.0,
      "end": 8.0,
      "text": "Ich hätte das Gespräch gerne anders mit Ihnen angefangen, aber wenn Sie es..."
    },
    {
      "start": 8.0,
      "end": 9.0,
      "text": "Ja, boi!"
    },
    {
      "start": 9.0,
      "end": 10.0,
      "text": "Was ist das?"
    },
    {
      "start": 10.0,
      "end": 12.0,
      "text": "Gib mir noch mein Gönnagiflachmann!"
    },
    {
      "start": 12.0,
      "end": 15.5,
      "text": "Was ist denn los heute?"
    },
    {
      "start": 15.5,
      "end": 17.5,
      "text": "Hä?"
    },
    {
      "start": 17.5,
      "end": 21.2,
      "text": "Mein Gönnagiflachmann?"
    },
    {
      "start": 21.2,
      "end": 23.2,
      "text": "Schützenfest!"
    },
    {
      "start": 23.2,
      "end": 25.2,
      "text": "Chabooor!"
    },
    {
      "start": 28.2,
      "end": 32.2,
      "text": "Wer auch immer das synchronisiert hat, braucht eine Gehaltserhöhung."
    },
    {
      "start": 32.2,
      "end": 34.2,
      "text": "Natürlich!"
    },
    {
      "start": 34.2,
      "end": 36.2,
      "text": "Ich kann atmen, ja."
    },
    {
      "start": 49.5,
      "end": 54.5,
      "text": "Als wenn der in real gesagt hat, gib mir mein Gönnagiflachmann, Digga!"
    },
    {
      "start": 54.5,
      "end": 56.5,
      "text": "Was ist das denn für eine Scheiße?"
    },
    {
      "start": 56.5,
      "end": 58.5,
      "text": "Also wirklich!"
    }
  ]
}