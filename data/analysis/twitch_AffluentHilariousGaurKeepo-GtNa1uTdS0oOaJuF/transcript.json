{
  "language": "sl",
  "segments": [
    {
      "start": 0.3,
      "end": 6.9,
      "text": "Na kva je?"
    },
    {
      "start": 6.9,
      "end": 8.9,
      "text": "Stala na bogljenu."
    },
    {
      "start": 8.9,
      "end": 10.9,
      "text": "I čil izkeš?"
    },
    {
      "start": 10.9,
      "end": 12.9,
      "text": "Aj, repis, na!"
    },
    {
      "start": 12.9,
      "end": 18.1,
      "text": "Na!"
    },
    {
      "start": 20.1,
      "end": 23.1,
      "text": "Niko ne av prav, da gleže nam i goho sven menere."
    },
    {
      "start": 23.1,
      "end": 26.1,
      "text": "Samo asmo, da glem ciste na že nas, ili ga pipam ve."
    },
    {
      "start": 26.1,
      "end": 28.1,
      "text": "Alo! Otrebki čirmani!"
    },
    {
      "start": 28.1,
      "end": 30.1,
      "text": "Čivo je bav v kudste mrstn skapani?"
    }
  ]
}