      "text": "Смотри!"
    },
    {
      "start": 1.0,
      "end": 3.6,
      "text": "О!"
    },
    {
      "start": 3.6,
      "end": 6.2,
      "text": "Нет!"
    },
    {
      "start": 6.2,
      "end": 7.2,
      "text": "Нет!"
    },
    {
      "start": 7.2,
      "end": 8.2,
      "text": "Только не снова!"
    },
    {
      "start": 8.2,
      "end": 11.2,
      "text": "Только не снова!"
    },
    {
      "start": 11.2,
      "end": 13.2,
      "text": "Мой..."
    },
    {
      "start": 13.2,
      "end": 20.9,
      "text": "Сломал член!"
    },
    {
      "start": 20.9,
      "end": 22.9,
      "text": "Люсия!"
    },
    {
      "start": 22.9,
      "end": 24.9,
      "text": "Поднеси меня!"
    },
    {
      "start": 24.9,
      "end": 26.9,
      "text": "Прошу!"
    },
    {
      "start": 26.9,
      "end": 28.9,
      "text": "Мое хозяйство в опасности!"
    },
    {
      "start": 28.9,
      "end": 30.9,
      "text": "Неси меня в машину!"
    },
    {
      "start": 30.9,
      "end": 32.9,
      "text": "Она неподалёку!"
    },
    {
      "start": 32.9,
      "end": 37.9,
      "text": "Ты мне будешь за это до конца жизни обязан и продашь все свои досити-коины."
    },
    {
      "start": 37.9,
      "end": 42.0,
      "text": "Чёрт, он на свой член..."
    },
    {
      "start": 42.0,
      "end": 45.0,
      "text": "Сочувствуй его жене!"
    },
    {
      "start": 45.0,
      "end": 49.8,
      "text": "А он мне нравится."
    },
    {
      "start": 49.8,
      "end": 50.8,
      "text": "Что мне на плече?"
    },
    {
      "start": 50.8,
      "end": 52.8,
      "text": "Афу!"
    }
  ]
