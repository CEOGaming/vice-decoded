{
  "language": "ru",
  "segments": [
    {
      "start": 2.2,
      "end": 6.2,
      "text": "Вил? Да. Ты мой в прошлый раз увидели еще."
    },
    {
      "start": 11.3,
      "end": 13.3,
      "text": "Сучит. Вы, вы, другой ли..."
    },
    {
      "start": 17.0,
      "end": 20.0,
      "text": "Смотри, это тоже сразу подлить. Ебаный в рот."
    },
    {
      "start": 20.0,
      "end": 21.0,
      "text": "Да, ну нет."
    },
    {
      "start": 21.0,
      "end": 22.0,
      "text": "Что это? Что это?"
    },
    {
      "start": 23.0,
      "end": 24.0,
      "text": "А что титьки показали ее?"
    },
    {
      "start": 25.0,
      "end": 26.0,
      "text": "Я, я пропустил, я на Андрюху посмотрю."
    },
    {
      "start": 26.0,
      "end": 27.0,
      "text": "Бля, закрываю."
    },
    {
      "start": 27.0,
      "end": 28.0,
      "text": "А, показали."
    },
    {
      "start": 28.0,
      "end": 29.0,
      "text": "Спасибо."
    },
    {
      "start": 29.0,
      "end": 30.0,
      "text": "На миллисекунд."
    }
  ]
}