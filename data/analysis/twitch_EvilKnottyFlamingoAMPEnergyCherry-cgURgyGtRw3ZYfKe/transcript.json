{
  "language": "es",
  "segments": [
    {
      "start": 0.1,
      "end": 2.1,
      "text": "¿Por qué no me deja agarrarlo?"
    },
    {
      "start": 3.1,
      "end": 5.1,
      "text": "¿Por qué no me deja agarrarlo, mi gente?"
    },
    {
      "start": 5.1,
      "end": 6.1,
      "text": "¿Tengo que dispararme?"
    },
    {
      "start": 6.1,
      "end": 7.1,
      "text": "¡Eh! ¡Sí!"
    },
    {
      "start": 7.1,
      "end": 9.1,
      "text": "¡Vamos, vamos, vamos!"
    },
    {
      "start": 9.1,
      "end": 11.1,
      "text": "Son 500 dólares."
    },
    {
      "start": 11.1,
      "end": 12.1,
      "text": "¡Eh! ¡La policía!"
    },
    {
      "start": 12.1,
      "end": 13.1,
      "text": "¡Currele!"
    },
    {
      "start": 13.1,
      "end": 15.1,
      "text": "¡No mames que todo por 500 dólares!"
    },
    {
      "start": 16.1,
      "end": 17.1,
      "text": "¡No!"
    },
    {
      "start": 17.1,
      "end": 18.1,
      "text": "¡No, no, no!"
    },
    {
      "start": 18.1,
      "end": 19.1,
      "text": "¡Pinche patrulla! ¡Currele!"
    },
    {
      "start": 19.1,
      "end": 20.1,
      "text": "¡Currele, currele!"
    },
    {
      "start": 20.1,
      "end": 21.1,
      "text": "¡Vámonos!"
    },
    {
      "start": 21.1,
      "end": 23.1,
      "text": "¿Qué pasa si dejamos ahorita, no?"
    },
    {
      "start": 23.1,
      "end": 25.1,
      "text": "¿Qué pasa si dejamos dinero?"
    },
    {
      "start": 25.1,
      "end": 32.9,
      "text": "¡Vamos a ver!"
    },
    {
      "start": 32.9,
      "end": 33.9,
      "text": "¡Eh!"
    },
    {
      "start": 33.9,
      "end": 34.9,
      "text": "¡Eh, qué pasó, qué pasó!"
    },
    {
      "start": 34.9,
      "end": 39.5,
      "text": "¡No tiene bolsas de tinta, güey!"
    },
    {
      "start": 42.6,
      "end": 43.6,
      "text": "¡No!"
    },
    {
      "start": 44.6,
      "end": 45.6,
      "text": "¡No!"
    }
  ]
}