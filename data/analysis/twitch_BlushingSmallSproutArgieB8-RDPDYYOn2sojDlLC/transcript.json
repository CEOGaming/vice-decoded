{
  "language": "es",
  "segments": [
    {
      "start": 0.1,
      "end": 2.1,
      "text": "¡Ey, obreros!"
    },
    {
      "start": 4.1,
      "end": 8.1,
      "text": "Los obreros siempre son los que molestan a Lucía, pues ahora voy a molestar yo a vosotros."
    },
    {
      "start": 8.1,
      "end": 10.1,
      "text": "¡Sopla polla!"
    },
    {
      "start": 15.1,
      "end": 17.1,
      "text": "¿Va a tirar un cigarrón?"
    },
    {
      "start": 21.1,
      "end": 25.2,
      "text": "¡Dios!"
    },
    {
      "start": 26.2,
      "end": 31.4,
      "text": "¡Por todos los obreros que dicen cosas a las mujeres!"
    },
    {
      "start": 31.4,
      "end": 33.4,
      "text": "¡Por todos los obreros!"
    },
    {
      "start": 37.2,
      "end": 40.2,
      "text": "Bueno, bueno, se me está liando, ¿eh? Se me está liando la tarde."
    },
    {
      "start": 40.2,
      "end": 46.1,
      "text": "¡Se me está liando la tarde!"
    },
    {
      "start": 46.1,
      "end": 47.1,
      "text": "¡Ustia!"
    },
    {
      "start": 47.1,
      "end": 52.4,
      "text": "¿Dónde ha ido a parar?"
    },
    {
      "start": 53.4,
      "end": 55.4,
      "text": "¿Se le dispara uno?"
    }
  ]
}