{
  "language": "ne",
  "segments": [
    {
      "start": 2.1,
      "end": 4.1,
      "text": "तो मुझे लिएस लिएस लिएस?"
    },
    {
      "start": 4.1,
      "end": 6.1,
      "text": "आन?"
    },
    {
      "start": 6.1,
      "end": 12.2,
      "text": "बेरु गल्क्रिन च्या कोती जाना लेए ये रिएगो च्या बद्रा"
    },
    {
      "start": 12.2,
      "end": 15.2,
      "text": "शुद्देइसा तर तेती शुदा शुद्दे मेरोची"
    },
    {
      "start": 15.2,
      "end": 17.2,
      "text": "ये तो देट्ली अक्सिनेंद बो गाएस"
    },
    {
      "start": 17.2,
      "end": 19.2,
      "text": "लोई रोग लेगो"
    },
    {
      "start": 19.2,
      "end": 20.2,
      "text": "इत्टिख"
    },
    {
      "start": 20.2,
      "end": 25.6,
      "text": "शुद्दा तर आलेबो सी आत्टी को लिएस छिग्गेम तो उने बहने है नहीं नहीं"
    }
  ]
}