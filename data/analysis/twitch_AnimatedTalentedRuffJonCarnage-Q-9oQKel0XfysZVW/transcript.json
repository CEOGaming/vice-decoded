{
  "language": "zh",
  "segments": [
    {
      "start": 0.0,
      "end": 5.0,
      "text": "好貴喔,四百多,很省耶!"
    },
    {
      "start": 17.8,
      "end": 19.8,
      "text": "過程天就好"
    },
    {
      "start": 32.8,
      "end": 35.8,
      "text": "你也太沒禮貌了吧"
    },
    {
      "start": 35.8,
      "end": 37.8,
      "text": "什麼就不是她的不然是誰的"
    },
    {
      "start": 37.8,
      "end": 41.6,
      "text": "那為什麼她不要照顧他們的"
    },
    {
      "start": 41.6,
      "end": 43.6,
      "text": "她是小孩的耶"
    },
    {
      "start": 44.6,
      "end": 47.6,
      "text": "我看著夏好像對她的小孩"
    },
    {
      "start": 47.6,
      "end": 49.6,
      "text": "很有愛的感覺"
    },
    {
      "start": 49.6,
      "end": 52.6,
      "text": "她不是在那個監獄裡面的時候嗎"
    },
    {
      "start": 52.6,
      "end": 54.6,
      "text": "她怎麼感覺這男的"
    },
    {
      "start": 54.6,
      "end": 56.6,
      "text": "好像沒什麼在提醒她有小孩啊"
    }
  ]
}