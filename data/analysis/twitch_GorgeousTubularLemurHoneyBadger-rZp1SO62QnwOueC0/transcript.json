      "text": "Stara Ruro kurwa."
    },
    {
      "start": 8.1,
      "end": 10.1,
      "text": "Chcesz potańczyć?"
    },
    {
      "start": 10.1,
      "end": 12.1,
      "text": "O."
    },
    {
      "start": 12.1,
