      "end": 36.9,
      "text": "Serio tak uważam."
    },
    {
      "start": 36.9,
      "end": 38.9,
      "text": "Dobra, idę tu."
    },
    {
      "start": 38.9,
      "end": 40.9,
      "text": "O mój malborasie."
    },
    {
      "start": 40.9,
      "end": 42.9,
      "text": "To ja, to ja. Zobaczcie kurwa na mnie."
    },
