    {
      "start": 27.9,
      "end": 29.9,
      "text": "Rozpierdalam teraz."
    },
    {
      "start": 30.9,
      "end": 32.9,
      "text": "O."
    },
    {
      "start": 32.9,
      "end": 34.9,
      "text": "Tak, tak serio tak uważam."
