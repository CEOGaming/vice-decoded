{
  "language": "es",
  "segments": [
    {
      "start": 0.4,
      "end": 3.9,
      "text": "¡Ay, tú eres lo que el doctor me recetó!"
    },
    {
      "start": 4.9,
      "end": 6.9,
      "text": "Pues señora, hay gran potro cuando usted quiera, ¿eh?"
    },
    {
      "start": 6.9,
      "end": 8.9,
      "text": "No te hagas rico pastel."
    },
    {
      "start": 8.9,
      "end": 13.2,
      "text": "Pero, chico, no te creas cósmate."
    },
    {
      "start": 13.8,
      "end": 14.8,
      "text": "¡Toma!"
    },
    {
      "start": 14.8,
      "end": 15.8,
      "text": "¿Este es creep?"
    },
    {
      "start": 15.8,
      "end": 18.8,
      "text": "Pero es clase como me venga, tú eres."
    },
    {
      "start": 18.8,
      "end": 19.8,
      "text": "¡Control yourself!"
    },
    {
      "start": 19.8,
      "end": 21.8,
      "text": "¡Es algo normal!"
    },
    {
      "start": 21.8,
      "end": 22.8,
      "text": "¡Lamonos!"
    },
    {
      "start": 22.8,
      "end": 24.2,
      "text": "¡Nos vivimos aquí!"
    },
    {
      "start": 24.2,
      "end": 25.8,
      "text": "¡Tú eres slow, oja!"
    },
    {
      "start": 25.8,
      "end": 27.8,
      "text": "¡Eso es por eso que no hablas!"
    },
    {
      "start": 27.8,
      "end": 29.8,
      "text": "¡Tu madre debería jugar más difícil para ti!"
    },
    {
      "start": 30.7,
      "end": 32.7,
      "text": "Ok, I'm sorry."
    },
    {
      "start": 32.7,
      "end": 34.7,
      "text": "Oh, and by the way."
    },
    {
      "start": 34.7,
      "end": 35.7,
      "text": "Oh, tío."
    },
    {
      "start": 35.7,
      "end": 38.7,
      "text": "Que no te coja de nuevo, bestia venga."
    }
  ]
}