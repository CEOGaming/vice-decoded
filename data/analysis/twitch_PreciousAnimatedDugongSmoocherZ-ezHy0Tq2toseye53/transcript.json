{
  "language": "ru",
  "segments": [
    {
      "start": 0.0,
      "end": 4.7,
      "text": "Оно не открывается, я клянусь."
    },
    {
      "start": 4.7,
      "end": 6.7,
      "text": "Здравствуйте. Я представитель компании Рачукстар."
    },
    {
      "start": 6.7,
      "end": 8.7,
      "text": "Квы тебе они слоны бьет, но из орога."
    },
    {
      "start": 8.7,
      "end": 10.7,
      "text": "Соси, соси, соси."
    },
    {
      "start": 10.7,
      "end": 13.7,
      "text": "Засужу вас. Сами будете потом платить мне деньги."
    },
    {
      "start": 13.7,
      "end": 18.8,
      "text": "Рокстар, ебени."
    },
    {
      "start": 18.8,
      "end": 22.4,
      "text": "Оно не открывается, реально."
    },
    {
      "start": 22.4,
      "end": 24.4,
      "text": "Я клянусь вам не открывается."
    },
    {
      "start": 24.4,
      "end": 27.4,
      "text": "Я что, блять, вы думаете о 10... Я сбоин гонаху бы прыгил."
    },
    {
      "start": 27.4,
      "end": 28.4,
      "text": "Вообще, блять, с кем разговариваете?"
    },
    {
      "start": 28.4,
      "end": 29.4,
      "text": "Скиньте клип."
    },
    {
      "start": 29.4,
      "end": 30.4,
      "text": "Скиньте клип."
    },
    {
      "start": 30.4,
      "end": 31.4,
      "text": "Хорошая попытка."
    },
    {
      "start": 31.4,
      "end": 41.9,
      "text": "Прямо сейчас клип с самолетом."
    },
    {
      "start": 41.9,
      "end": 43.9,
      "text": "В доказательство тому..."
    },
    {
      "start": 43.9,
      "end": 51.3,
      "text": "Скиньте, пожалуйста, клип вчерашний с самолетом."
    },
    {
      "start": 51.3,
      "end": 54.3,
      "text": "В доказательство того, что я не мог просто открыть парашют."
    },
    {
      "start": 54.3,
      "end": 57.6,
      "text": "Упал, как щебень."
    }
  ]
}