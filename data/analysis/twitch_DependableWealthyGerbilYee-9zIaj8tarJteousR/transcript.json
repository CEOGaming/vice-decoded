  "segments": [
    {
      "start": 0.1,
      "end": 3.3,
      "text": "Он не имеет коннекции, чтобы получить то, что нужно"
    },
    {
      "start": 3.3,
      "end": 5.3,
      "text": "Ты имеешь в виду, что нет идентий?"
    },
    {
      "start": 5.3,
      "end": 7.9,
      "text": "Ха-ха-ха, ты не имеешь в виду, что нет идентий?"
    },
    {
      "start": 7.9,
      "end": 17.1,
      "text": "Теперь, что я имею в виду, то есть, мы будем получать партию из-за того, что нет проблем, нет альбенеев"
    },
    {
      "start": 17.1,
      "end": 20.4,
      "text": "Ги-Джи в бизнесе, ты слышишь?"
    },
    {
      "start": 20.4,
      "end": 21.4,
      "text": "Это вероятно!"
    },
    {
      "start": 21.4,
      "end": 23.4,
      "text": "Ты мальчик!"
    },
    {
      "start": 23.4,
      "end": 26.9,
      "text": "Эй, что за фиг?"
    },
    {
      "start": 26.9,
      "end": 28.9,
      "text": "Фитов!"
    },
    {
      "start": 29.4,
      "end": 31.4,
      "text": "Кто приехал-то?"
    },
    {
      "start": 35.4,
      "end": 37.4,
      "text": "Это кто, блядь?"
    },
    {
      "start": 48.9,
      "end": 59.2,
      "text": "А почему у нас это в автомоде? Мы много писали про него?"
    },
    {
      "start": 59.2,
      "end": 61.2,
      "text": "Ника Белль"
    }
  ]
