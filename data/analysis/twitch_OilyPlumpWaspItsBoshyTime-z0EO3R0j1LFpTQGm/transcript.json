{
  "language": "it",
  "segments": [
    {
      "start": 0.1,
      "end": 1.1,
      "text": "What's up?"
    },
    {
      "start": 1.1,
      "end": 2.0,
      "text": "Hey!"
    },
    {
      "start": 2.0,
      "end": 3.0,
      "text": "I'll make this quick."
    },
    {
      "start": 3.0,
      "end": 6.0,
      "text": "I heard you're the one to see about some payments."
    },
    {
      "start": 6.0,
      "end": 7.0,
      "text": "Oh, jeez."
    },
    {
      "start": 7.0,
      "end": 9.1,
      "text": "Sorry, officer, but I'm fine."
    },
    {
      "start": 9.1,
      "end": 11.1,
      "text": "Fradella, ma che è un la goticona di Drake?"
    },
    {
      "start": 11.1,
      "end": 12.1,
      "text": "It depends."
    },
    {
      "start": 12.1,
      "end": 15.1,
      "text": "Questa è la goticona di Drake, palese."
    },
    {
      "start": 15.1,
      "end": 16.1,
      "text": "Nobody's begging."
    },
    {
      "start": 16.1,
      "end": 17.1,
      "text": "Non proprio tutti."
    },
    {
      "start": 17.1,
      "end": 18.1,
      "text": "No, effettivamente."
    },
    {
      "start": 18.1,
      "end": 19.1,
      "text": "All right."
    },
    {
      "start": 19.1,
      "end": 21.1,
      "text": "Let's come in for a second."
    },
    {
      "start": 21.1,
      "end": 22.1,
      "text": "Ma che voce c'hai?"
    },
    {
      "start": 22.1,
      "end": 24.1,
      "text": "Sai che pare, a voce te mai li sai, russa?"
    },
    {
      "start": 24.1,
      "end": 25.1,
      "text": "Bro."
    },
    {
      "start": 25.1,
      "end": 26.1,
      "text": "Si parla."
    },
    {
      "start": 26.1,
      "end": 28.1,
      "text": "Devo essere un nesto."
    },
    {
      "start": 28.1,
      "end": 31.1,
      "text": "Non esagerate un po' con le zinne, secondo me."
    },
    {
      "start": 31.1,
      "end": 32.0,
      "text": "Babbina, sta da sua nonna."
    },
    {
      "start": 32.0,
      "end": 33.0,
      "text": "Te prendo le pillole."
    },
    {
      "start": 33.0,
      "end": 34.0,
      "text": "A com'atete pure?"
    },
    {
      "start": 34.0,
      "end": 35.0,
      "text": "Dove, precisamente, bro?"
    },
    {
      "start": 35.0,
      "end": 36.0,
      "text": "Cioè, non..."
    },
    {
      "start": 36.0,
      "end": 37.0,
      "text": "Dove mi siete?"
    },
    {
      "start": 37.0,
      "end": 38.0,
      "text": "Mi siete o prendo la EDS?"
    },
    {
      "start": 38.0,
      "end": 40.0,
      "text": "Probabilmente."
    },
    {
      "start": 40.0,
      "end": 41.0,
      "text": "Mi siete, però..."
    },
    {
      "start": 41.0,
      "end": 43.0,
      "text": "No, non mi posso sentire meno qui."
    },
    {
      "start": 43.0,
      "end": 44.0,
      "text": "Non c'è bisogno di..."
    },
    {
      "start": 44.0,
      "end": 45.0,
      "text": "Non..."
    },
    {
      "start": 45.0,
      "end": 46.0,
      "text": "Che devo rubare?"
    },
    {
      "start": 46.0,
      "end": 48.0,
      "text": "Ah, me posso fumare un arghile, però."
    },
    {
      "start": 48.0,
      "end": 50.0,
      "text": "Senzo fam una botta di un arghile."
    },
    {
      "start": 50.0,
      "end": 51.0,
      "text": "Alluci, cioè, tu posso..."
    },
    {
      "start": 51.0,
      "end": 52.0,
      "text": "Almeno chiede."
    },
    {
      "start": 52.0,
      "end": 53.0,
      "text": "C'è bo..."
    },
    {
      "start": 53.0,
      "end": 56.8,
      "text": "Non lo so."
    },
    {
      "start": 56.8,
      "end": 58.8,
      "text": "50 do..."
    },
    {
      "start": 58.8,
      "end": 59.8,
      "text": "Piummian."
    }
  ]
}