  "segments": [
    {
      "start": 0.0,
      "end": 24.5,
      "text": "és tudtam ellenkezni."
    },
    {
      "start": 24.5,
      "end": 27.3,
      "text": "Húgyanom verbálisak vagyunk, nagyon feszült angulat, sátszok,"
    },
    {
      "start": 27.3,
      "end": 28.5,
      "text": "mi a helyzet?"
    },
    {
      "start": 28.5,
      "end": 37.3,
      "text": "Mi a fasz?"
    },
    {
      "start": 37.3,
      "end": 39.1,
      "text": "Ennyi!"
    },
    {
      "start": 39.1,
      "end": 41.1,
      "text": "Ez az ending!"
    },
    {
      "start": 41.1,
      "end": 43.3,
      "text": "Beszélnek a karakterek?"
    },
    {
      "start": 43.3,
      "end": 44.3,
      "text": "Nem!"
    },
    {
      "start": 44.3,
      "end": 46.7,
      "text": "Te sobb bagos a játék, indítsd újra bagos."
    },
    {
      "start": 46.7,
      "end": 48.5,
      "text": "Nem beszélnek a karaktereket!"
    },
    {
      "start": 48.5,
      "end": 51.3,
      "text": "Beszélnek a 13 évet, és kibarul a monster!"
    },
    {
      "start": 51.3,
      "end": 53.7,
      "text": "Én is azt néztem, hallod, csak forgatják a felüket,"
    },
    {
      "start": 53.7,
      "end": 55.9,
      "text": "meg ízni, mi kálnak bazdak, de nem beszélnek ennek,"
    },
    {
      "start": 55.9,
      "end": 57.3,
      "text": "nem beszéltek az én ending."
    },
    {
      "start": 57.3,
      "end": 60.3,
      "text": "Tényleg, hát nem beszélnek a karaktereket!"
    }
  ]
}