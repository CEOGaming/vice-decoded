{
  "language": "pt",
  "segments": [
    {
      "start": 7.3,
      "end": 10.3,
      "text": "Tá doidão, maluco? Tá doidão, maluco?"
    },
    {
      "start": 11.3,
      "end": 14.3,
      "text": "Mano, o que que esse mendigo tá fazendo?"
    },
    {
      "start": 14.3,
      "end": 27.1,
      "text": "Tá chapada aí, meu mano."
    },
    {
      "start": 29.1,
      "end": 30.1,
      "text": "Gente!"
    },
    {
      "start": 36.6,
      "end": 46.3,
      "text": "Mano, maluco, virou o meu ca..."
    },
    {
      "start": 46.3,
      "end": 49.3,
      "text": "Mano, que cabaneiro maldito do nada."
    },
    {
      "start": 50.3,
      "end": 52.3,
      "text": "Olha aí, esse cara tá bêbado."
    },
    {
      "start": 55.3,
      "end": 57.3,
      "text": "Desce do carro, vagabundo. Desce do carro."
    },
    {
      "start": 57.3,
      "end": 59.3,
      "text": "Esse cara tá bêbado, mano."
    }
  ]
}