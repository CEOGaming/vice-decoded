{
  "language": "pt",
  "segments": [
    {
      "start": 0.0,
      "end": 3.0,
      "text": "É um carro legal."
    },
    {
      "start": 3.0,
      "end": 9.3,
      "text": "Só pra salvar, é assim mesmo."
    },
    {
      "start": 9.3,
      "end": 17.0,
      "text": "Oi! Eu tava olhando pro chat, cara!"
    },
    {
      "start": 17.0,
      "end": 19.0,
      "text": "Meu Deus do céu!"
    },
    {
      "start": 19.0,
      "end": 24.5,
      "text": "Puta que pariu!"
    },
    {
      "start": 24.5,
      "end": 28.5,
      "text": "Caralho, o jupinho do cara foi pra cuidar do caro dele."
    },
    {
      "start": 28.5,
      "end": 31.5,
      "text": "O primeiro que eu fiz foi jogar no mar."
    },
    {
      "start": 31.5,
      "end": 34.5,
      "text": "Cara, eu juro que eu tava olhando pro chat, velho."
    },
    {
      "start": 34.5,
      "end": 36.5,
      "text": "Calma, eu recupero."
    },
    {
      "start": 36.5,
      "end": 39.5,
      "text": "Os scooter brons vão dar um jeito."
    },
    {
      "start": 39.5,
      "end": 41.5,
      "text": "Fica tranquilo."
    },
    {
      "start": 42.5,
      "end": 44.5,
      "text": "É tudo só pra escapar da polícia."
    },
    {
      "start": 44.5,
      "end": 46.5,
      "text": "Filho, isso aqui é estoque."
    },
    {
      "start": 46.5,
      "end": 49.5,
      "text": "Se eu tentar deixar o carro ali ou se eu fugir,"
    },
    {
      "start": 49.5,
      "end": 51.5,
      "text": "a polícia vai aprender e vai dar merda, entendeu?"
    },
    {
      "start": 51.5,
      "end": 54.8,
      "text": "Agora não."
    },
    {
      "start": 54.8,
      "end": 56.8,
      "text": "Calma, vai dar tudo certo."
    },
    {
      "start": 56.8,
      "end": 58.8,
      "text": "Que reseta! Sobe!"
    }
  ]
}