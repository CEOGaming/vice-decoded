  "segments": [
    {
      "start": 2.0,
      "end": 5.0,
      "text": "¿Por qué esa no, chicos? ¿Es otra chica?"
    },
    {
      "start": 26.7,
      "end": 28.7,
      "text": "¡Espera, espera! ¡Momento, momento, momento!"
    },
    {
      "start": 28.7,
      "end": 30.7,
      "text": "¿Por qué ahora está todo el mundo diciendo que no?"
    },
    {
      "start": 30.7,
      "end": 32.7,
      "text": "¿Por qué ahora estáis todos diciendo que no?"
    },
    {
      "start": 32.7,
      "end": 39.7,
      "text": "No, Mario, que estoy desayunando."
    },
    {
      "start": 39.7,
      "end": 41.7,
      "text": "¡Oye, gente! ¡Me voy!"
    },
    {
      "start": 41.7,
      "end": 43.7,
      "text": "¡Oye, gente, por favor!"
    },
    {
      "start": 43.7,
      "end": 46.7,
      "text": "¡Es otra trabajadora!"
    }
  ]
