{
  "language": "ru",
  "segments": [
    {
      "start": 3.0,
      "end": 5.0,
      "text": "Ну всё, хватит, наверное, да?"
    },
    {
      "start": 6.4,
      "end": 13.5,
      "text": "Не-не-не, блядь, шо, куда она лезет, блядь?"
    },
    {
      "start": 13.5,
      "end": 17.0,
      "text": "Я так уже делал!"
    },
    {
      "start": 20.5,
      "end": 22.5,
      "text": "Бля, хоть бы не забанили, блядь!"
    },
    {
      "start": 24.2,
      "end": 29.1,
      "text": "Не баньте, это и врану, чё, афуели! Вы сами это пропустили, твич, don't ban me!"
    },
    {
      "start": 29.1,
      "end": 32.2,
      "text": "Из геймс, а у меня есть идил плюс стрим!"
    },
    {
      "start": 39.2,
      "end": 40.3,
      "text": "Кариночка!"
    },
    {
      "start": 41.3,
      "end": 43.3,
      "text": "Очень, и хочешь ещё?"
    },
    {
      "start": 45.3,
      "end": 47.3,
      "text": "Так всё, мать, давай!"
    },
    {
      "start": 47.3,
      "end": 51.3,
      "text": "Давайте, солнце, увидимся! Я, кстати, остался эту движуху, блядь!"
    },
    {
      "start": 51.3,
      "end": 55.3,
      "text": "Тихо, шо, блядь! Тихо! Тихо, тихо!"
    },
    {
      "start": 57.3,
      "end": 59.3,
      "text": "Кондексу!"
    }
  ]
}