{
  "language": "es",
  "segments": [
    {
      "start": 0.0,
      "end": 4.6,
      "text": "Te lo juro que le meto un puñelazo entendido de verdad, coca y nómano, hijo de puta putero de mierda."
    },
    {
      "start": 10.6,
      "end": 11.8,
      "text": "Ven aquí, Gustavo, ven."
    },
    {
      "start": 12.4,
      "end": 13.9,
      "text": "El verdadero malo del juego."
    },
    {
      "start": 15.6,
      "end": 17.7,
      "text": "Romaníños. Ven aquí, Romaníños."
    },
    {
      "start": 18.1,
      "end": 20.6,
      "text": "Ven aquí, Romaníños. Ven aquí."
    },
    {
      "start": 24.6,
      "end": 25.9,
      "text": "Ven aquí, Gustavo."
    },
    {
      "start": 26.5,
      "end": 27.5,
      "text": "¿Dónde estás?"
    },
    {
      "start": 44.6,
      "end": 46.6,
      "text": "¿200? Es por un bien mayor."
    },
    {
      "start": 49.5,
      "end": 50.5,
      "text": "Ah, no puedo."
    },
    {
      "start": 51.8,
      "end": 54.5,
      "text": "Joder, yo ya iba enfilado, tío, tengo que volver."
    }
  ]
}