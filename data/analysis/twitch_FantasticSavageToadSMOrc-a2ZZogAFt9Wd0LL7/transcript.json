{
  "language": "zh",
  "segments": [
    {
      "start": 0.0,
      "end": 1.0,
      "text": "你怎麼會這樣"
    },
    {
      "start": 1.0,
      "end": 2.5,
      "text": "為什麼你都會跳"
    },
    {
      "start": 2.5,
      "end": 3.5,
      "text": "我們要跳"
    },
    {
      "start": 3.5,
      "end": 5.0,
      "text": "對,不太遠"
    },
    {
      "start": 5.0,
      "end": 6.0,
      "text": "來試試看"
    },
    {
      "start": 6.0,
      "end": 7.0,
      "text": "跳橋"
    },
    {
      "start": 9.0,
      "end": 9.5,
      "text": "要嗎"
    },
    {
      "start": 9.5,
      "end": 10.5,
      "text": "當然"
    },
    {
      "start": 10.5,
      "end": 11.5,
      "text": "來吧,寶貝"
    },
    {
      "start": 12.0,
      "end": 13.5,
      "text": "神經病,他媽突然"
    },
    {
      "start": 13.5,
      "end": 14.0,
      "text": "突然到路邊"
    },
    {
      "start": 14.0,
      "end": 15.0,
      "text": "他媽突然跳橋"
    },
    {
      "start": 15.0,
      "end": 16.0,
      "text": "靠飛喔"
    },
    {
      "start": 20.5,
      "end": 21.5,
      "text": "好啊,一起跳啊"
    },
    {
      "start": 21.5,
      "end": 22.5,
      "text": "好美,跳美"
    },
    {
      "start": 22.5,
      "end": 23.5,
      "text": "走美"
    },
    {
      "start": 24.5,
      "end": 25.5,
      "text": "好美"
    },
    {
      "start": 27.6,
      "end": 28.6,
      "text": "還可以牽手喔"
    },
    {
      "start": 29.6,
      "end": 30.6,
      "text": "好嗎"
    },
    {
      "start": 34.3,
      "end": 35.8,
      "text": "這樣可以加愛心耶"
    },
    {
      "start": 35.8,
      "end": 38.7,
      "text": "哇靠"
    },
    {
      "start": 40.2,
      "end": 42.2,
      "text": "好美,他媽跳橋"
    },
    {
      "start": 42.2,
      "end": 43.2,
      "text": "幹你"
    },
    {
      "start": 44.2,
      "end": 46.2,
      "text": "幹你耶,你他媽"
    },
    {
      "start": 46.2,
      "end": 51.9,
      "text": "我操你媽"
    },
    {
      "start": 51.9,
      "end": 59.5,
      "text": "你他媽的,我他媽把你們殺的"
    },
    {
      "start": 59.5,
      "end": 60.5,
      "text": "操"
    }
  ]
}