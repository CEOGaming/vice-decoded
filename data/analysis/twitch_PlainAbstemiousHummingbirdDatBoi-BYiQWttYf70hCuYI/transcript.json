{
  "language": "pt",
  "segments": [
    {
      "start": 0.0,
      "end": 3.6,
      "text": "Agora, pegue um de eles, Dixman. Eu peguei um de eles, perfeitamente."
    },
    {
      "start": 4.6,
      "end": 7.6,
      "text": "Ok, eles são todos os mesmos ou diferentes?"
    },
    {
      "start": 8.1,
      "end": 8.6,
      "text": "Pega aí."
    },
    {
      "start": 8.6,
      "end": 12.3,
      "text": "Não vou mentir, mano, o azulzinho me chama a atenção, tá ligado?"
    },
    {
      "start": 12.6,
      "end": 13.4,
      "text": "Espera, espera, espera."
    },
    {
      "start": 14.2,
      "end": 15.2,
      "text": "O que é aí no fundo?"
    },
    {
      "start": 15.6,
      "end": 16.4,
      "text": "Tem algo conhecido."
    },
    {
      "start": 16.4,
      "end": 17.6,
      "text": "É um microfone, pô."
    },
    {
      "start": 18.2,
      "end": 19.2,
      "text": "Tem como um simbol."
    },
    {
      "start": 19.6,
      "end": 21.3,
      "text": "Oh, um simbol no fundo?"
    },
    {
      "start": 21.9,
      "end": 23.3,
      "text": "Pode ser o que estamos procurando, pô."
    },
    {
      "start": 24.0,
      "end": 24.9,
      "text": "Ei, o que é o cheiro?"
    },
    {
      "start": 24.9,
      "end": 25.4,
      "text": "Booty?"
    },
    {
      "start": 31.6,
      "end": 33.6,
      "text": "Sim. Eu acho que eu escutei aquele palco."
    },
    {
      "start": 41.0,
      "end": 41.7,
      "text": "Um gringo."
    },
    {
      "start": 42.1,
      "end": 43.3,
      "text": "Totalmente valeu, vamos lá."
    },
    {
      "start": 44.7,
      "end": 46.7,
      "text": "É tudo. Eu tenho que me ensinar aqui."
    },
    {
      "start": 50.3,
      "end": 51.4,
      "text": "Eu fiz isso, cara, vamo."
    },
    {
      "start": 52.4,
      "end": 53.3,
      "text": "Pegue esse merda."
    },
    {
      "start": 54.1,
      "end": 55.1,
      "text": "Pegue a puta."
    }
